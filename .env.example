# LLM Providers 
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key_here

# Optional — add these to unlock additional providers in the UI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default provider shown in the UI (google | openai | anthropic)
NEXT_PUBLIC_DEFAULT_PROVIDER=google

# Database 
POSTGRES_USER=llmobs
POSTGRES_PASSWORD=llmobs_secret
POSTGRES_DB=llmobs

# Used by apps/web and apps/ingestion to connect to Postgres
# In Docker: host is "postgres" (the service name)
# Locally:   host is "localhost"
DATABASE_URL=postgresql://llmobs:llmobs_secret@postgres:5432/llmobs

# Service URLs 
# URL that apps/web uses to POST log events to the ingestion service
# In Docker: http://ingestion:4001
# Locally:   http://localhost:4001
INGESTION_SERVICE_URL=http://ingestion:4001

# Port the ingestion service listens on
INGESTION_PORT=4001

# Next.js 
NEXT_PUBLIC_APP_URL=http://localhost:3000
